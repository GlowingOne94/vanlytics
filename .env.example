# Database (MySQL) — e.g. Railway, PlanetScale, RDS
DATABASE_URL=mysql://user:password@host:3306/fleet_guardian

# Session signing secret — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# LLM provider for the AI Advisor (OpenAI-compatible chat completions API)
LLM_API_URL=https://api.openai.com
LLM_API_KEY=sk-...
LLM_DEFAULT_MODEL=gpt-4o-mini

# Object storage (S3-compatible: AWS S3 or Cloudflare R2)
S3_BUCKET=vanlytics-uploads
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

PORT=3000
NODE_ENV=development

# Google Maps JavaScript API key, for the Live Map page (needs the "Maps
# JavaScript API" enabled on this key in Google Cloud Console). Note the
# VITE_ prefix — Vite only exposes env vars with this prefix to the browser.
VITE_GOOGLE_MAPS_API_KEY=

# Where "Contact us about onboarding/setup services" inquiries from the
# landing page get emailed. Falls back to RESEND_FROM_EMAIL if unset.
SERVICE_INQUIRY_NOTIFY_EMAIL=
